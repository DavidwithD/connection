{
  "name": "connection",
  "version": "0.1.0",
  "private": true,
  "description": "A graph you pan around, stored in the browser (name provisional)",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "web": "vite",
    "build": "vite build",
    "drive:map": "node scripts/drive-map.mjs",
    "drive:join": "node scripts/drive-join.mjs",
    "drive:part-edge": "node scripts/drive-part-edge.mjs",
    "drive:drag-join": "node scripts/drive-drag-join.mjs",
    "drive:rename": "node scripts/drive-rename.mjs",
    "drive:nodes": "node scripts/drive-nodes.mjs",
    "drive:globe": "node scripts/drive-globe.mjs",
    "typecheck": "tsc --noEmit",
    "adr": "python3 scripts/adr-gate.py",
    "docs": "python3 scripts/docs-gate.py",
    "docs:selftest": "python3 scripts/docs-gate-selftest.py",
    "prose": "python3 scripts/prose-lint.py",
    "prose:selftest": "python3 scripts/prose-lint-selftest.py",
    "hooks:install": "ln -sfn ../../scripts/hooks/pre-commit .git/hooks/pre-commit && echo 'pre-commit: gates installed'",
    "test": "npm run typecheck && npm run adr && npm run docs"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "dependencies": {
    "cytoscape": "^3.34.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
