# Copy to `.env` and adjust. Nothing here is secret — these are local defaults.

# ---------------------------------------------------------------------------
# Local development (DynamoDB Local)
# ---------------------------------------------------------------------------
# Setting DYNAMODB_ENDPOINT is what switches the app to the local server.
# Unset it (or leave it empty) to talk to real AWS DynamoDB instead.
DYNAMODB_ENDPOINT=http://localhost:8000

AWS_REGION=us-east-1
DYNAMODB_TABLE=connection

# DynamoDB Local ignores credentials when started with -sharedDb, but the AWS
# SDK refuses to sign a request without them. The client supplies these dummy
# values automatically when DYNAMODB_ENDPOINT is set, so you normally do not
# need them here.
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local

# ---------------------------------------------------------------------------
# Real AWS
# ---------------------------------------------------------------------------
# Delete DYNAMODB_ENDPOINT above, then authenticate however you normally do
# (AWS_PROFILE, SSO, IRSA, instance role). The default credential chain applies.
# AWS_PROFILE=your-profile
