node_modules/
dist/

# Vite reads these. Nothing in the app does — the graph is in the browser and there is no
# process to configure.
.env
.env.local

.DS_Store
*.log
__pycache__/

# Graph files, in either format. The transfer page downloads them and they are your data, not
# the repo's. A text graph worth keeping goes in under a name you chose.
graph-export*.json
graph.txt
graph-names.txt

# Screenshots from `node scripts/drive-map.mjs`. Evidence for one change, not the repo's.
.shots/

# Scratch: pages and scripts written to settle one question, kept only until it is settled.
# A measurement worth keeping goes in the design doc as a number, not in here as a page.
temp/
